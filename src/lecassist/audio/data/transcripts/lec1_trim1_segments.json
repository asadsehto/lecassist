[
  {
    "start": 0.0,
    "end": 3.0,
    "text": "ٹھیک ہے پیسی سٹین کیا ہوگی؟"
  },
  {
    "start": 6.5,
    "end": 8.72,
    "text": "ایک اور دفعہ اس نے پروڈیوز کیا"
  },
  {
    "start": 10.639999999999999,
    "end": 14.26,
    "text": "اور پھر کیا بن گئی؟ نل بن گئی تو کیا ہو جائے گی؟"
  },
  {
    "start": 14.26,
    "end": 20.08,
    "text": "دو پیرنسیس، تین پیرنسیس، چھار پیرنسیس، یہ بریں گی نا؟"
  },
  {
    "start": 20.08,
    "end": 22.86,
    "text": "جتنی پیرنسیس اوپن ہوں گی تو نہیں ہی؟"
  },
  {
    "start": 23.599999999999998,
    "end": 24.56,
    "text": "سیمپل سی گرامر"
  },
  {
    "start": 25.44,
    "end": 28.72,
    "text": "اب اس کون بناتے ہیں سبسیکیوٹ کرتے ہیں"
  },
  {
    "start": 32.08,
    "end": 34.08,
    "text": "تو اس کا فرسٹ ان فالو نکالے،"
  },
  {
    "start": 34.08,
    "end": 35.88,
    "text": "what is the فرسٹ؟"
  },
  {
    "start": 35.88,
    "end": 36.94,
    "text": "open parenthesis"
  },
  {
    "start": 38.06,
    "end": 39.34,
    "text": "صرف ایک ہی ہے؟"
  },
  {
    "start": 39.34,
    "end": 40.04,
    "text": "اور؟"
  },
  {
    "start": 41.52,
    "end": 42.98,
    "text": "نلسٹری، ٹھیک ہے؟"
  },
  {
    "start": 42.98,
    "end": 45.2,
    "text": "دو فرسٹ آگئے، فرسٹ آف ایس کیا ہے؟"
  },
  {
    "start": 45.2,
    "end": 46.54,
    "text": "open parenthesis and"
  },
  {
    "start": 47.56,
    "end": 48.14,
    "text": "لیمڈا"
  },
  {
    "start": 48.14,
    "end": 51.08,
    "text": "ہم سٹارٹ کریں گے تو یہ پیرنسیس آگئے"
  },
  {
    "start": 51.08,
    "end": 54.12,
    "text": "اور جب سٹارٹ کریں گے، جنرےٹ کرتے گا"
  },
  {
    "start": 54.12,
    "end": 55.36,
    "text": "open parenthesis"
  },
  {
    "start": 56.34,
    "end": 57.9,
    "text": "ایس کیا کرتا ہے دوسرا؟"
  },
  {
    "start": 57.9,
    "end": 58.4,
    "text": "لیمڈا"
  },
  {
    "start": 58.4,
    "end": 60.8,
    "text": "لیمڈا کو کہاں ڈال دیں پروڈکشن رول کے مطابق؟"
  },
  {
    "start": 60.8,
    "end": 61.9,
    "text": "ٹیبل میں کہاں جائے گا؟"
  },
  {
    "start": 63.72,
    "end": 65.08,
    "text": "اس پروڈیس لیمڈا"
  },
  {
    "start": 66.32,
    "end": 68.28,
    "text": "لاسٹ کالن میں، کہاں جائے گا؟"
  },
  {
    "start": 68.9,
    "end": 72.98,
    "text": "لاسٹ کالن میں، کیونکہ لاسٹ میں انڈ آف سٹرنگ ہے، ڈالر اس میں جائے گا"
  },
  {
    "start": 72.98,
    "end": 74.74,
    "text": "فالو کیا ہوا ایس کا؟"
  },
  {
    "start": 74.74,
    "end": 76.18,
    "text": "ایس کا فالو کیا ہے؟"
  },
  {
    "start": 78.58000000000001,
    "end": 79.4,
    "text": "ڈالر"
  },
  {
    "start": 79.4,
    "end": 79.8,
    "text": "انجانگیسہ"
  },
  {
    "start": 79.8,
    "end": 80.9,
    "text": "فالو کیا تو ہوتا ہیے"
  },
  {
    "start": 80.9,
    "end": 82.36,
    "text": "دالر"
  },
  {
    "start": 83.34,
    "end": 85.7,
    "text": "فالو ہو گیا، کلوز پرنسیس دالر"
  },
  {
    "start": 85.7,
    "end": 106.02,
    "text": "ٹیمک ہو گیا، فالو سٹرنجھ پارنسیس ایک، فالو میں ک source"
  },
  {
    "start": 106.02,
    "end": 107.1,
    "text": "ایسے اور اچھabeئے ہیں"
  },
  {
    "start": 107.88,
    "end": 108.82,
    "text": "ایک ہی مارے اچھاب"
  },
  {
    "start": 109.96000000000001,
    "end": 111.8,
    "text": "ترمینار لگلئے آپ نے کون سا ترمینار ہے"
  },
  {
    "start": 111.8,
    "end": 114.46,
    "text": "ایک دو ترمینار لگلئے"
  },
  {
    "start": 114.46,
    "end": 115.62,
    "text": "واقعی کیا ہیں"
  },
  {
    "start": 116.78,
    "end": 117.46,
    "text": "دولار ہے"
  },
  {
    "start": 117.46,
    "end": 118.24,
    "text": "لگلئے"
  },
  {
    "start": 118.94,
    "end": 120.92,
    "text": "اب ایسے کیا پروڈیس ہو رہا ہے"
  },
  {
    "start": 120.92,
    "end": 122.48,
    "text": "start paranthesis"
  },
  {
    "start": 122.48,
    "end": 123.36,
    "text": "S"
  },
  {
    "start": 123.36,
    "end": 124.62,
    "text": "close paranthesis"
  },
  {
    "start": 124.62,
    "end": 126.2,
    "text": "یہ مالا production proof تھا"
  },
  {
    "start": 126.2,
    "end": 127.16,
    "text": "شو start paranthesis"
  },
  {
    "start": 127.16,
    "end": 127.78,
    "text": "پروڈیس کرا رہا تھا"
  },
  {
    "start": 127.78,
    "end": 128.64,
    "text": "وہ لگلئے یہاں پر"
  },
  {
    "start": 129.51999999999998,
    "end": 131.34,
    "text": "close paranthesis کون سا production rule"
  },
  {
    "start": 131.34,
    "end": 132.0,
    "text": "پروڈیس کرتا ہے"
  },
  {
    "start": 132.0,
    "end": 132.62,
    "text": "lambda"
  },
  {
    "start": 133.34,
    "end": 136.14,
    "text": "اس سے لامڈا ہو جائے گا تو کیا آگیا ہے"
  },
  {
    "start": 139.45999999999998,
    "end": 140.36,
    "text": "سب کو مشاہدہ ہے"
  },
  {
    "start": 141.07999999999998,
    "end": 144.58,
    "text": "کلوس پرنٹھیس لامڈا پروڈز کرنے پر کیسے آتی ہے"
  },
  {
    "start": 145.32,
    "end": 146.14,
    "text": "پر کلوس پرنٹھیس لامڈا پروڈز کرنے پر کیسے آتی ہے"
  },
  {
    "start": 146.14,
    "end": 148.42,
    "text": "اس سے لازم سے لازم سٹر ہوتا ہوتا ہے"
  },
  {
    "start": 150.14,
    "end": 152.76,
    "text": "ٹھیک ہو گیا اور اس میں تو آئے گی آئے گی"
  },
  {
    "start": 154.57999999999998,
