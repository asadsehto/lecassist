    "text": "ملس ٹھنگ میں"
  },
  {
    "start": 156.57999999999998,
    "end": 159.16,
    "text": "اب ہم اسٹارٹ کرتے ہیں"
  },
  {
    "start": 159.16,
    "end": 161.08,
    "text": "اسٹارٹ کلوس پرنٹھوس آگئی"
  },
  {
    "start": 161.89999999999998,
    "end": 162.92,
    "text": "اس پروڈیوز"
  },
  {
